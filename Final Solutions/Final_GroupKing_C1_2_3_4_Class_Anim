    def get_total_number_of_calculations_steps(self):
        '''Return the total number of calculation steps based on number of orbits'''
        return len(self.euler_x) # using length of euler_x array, since all same size
    
    def calculate_all_orbits(self):
        '''Calculate orbits using different calculation methods'''
        self.euler_method()
        self.rk2_method()
        self.rk4_method()
        self.leapfrog_method()
    
    def euler_method(self):
        '''Function for Euler integration method calculations ... 
        from C1 v2 edited to account for sun position not (0,0)'''
        # Set initial conditions
        self.euler_x[0] = self.x0
        self.euler_y[0] = self.y0
        self.euler_vx[0] = self.vx0
        self.euler_vy[0] = self.vy0
        
        total_number_of_calculations_steps = self.get_total_number_of_calculations_steps()
        pbar = tqdm(total=total_number_of_calculations_steps-1, desc=f'Euler method calculations...{self.name}')
        
        for n in range(total_number_of_calculations_steps - 1):
            dx = self.euler_x[n] - self.xs
            dy = self.euler_y[n] - self.ys
            r = np.hypot(dx, dy)
            
            # Acceleration due to gravity
            ax = -G * dx / r**3
            ay = -G * dy / r**3
            
            # Update position and velocity
            self.euler_x[n+1] = self.euler_x[n] + self.euler_vx[n] * dt_time_step_duration_years
            self.euler_y[n+1] = self.euler_y[n] + self.euler_vy[n] * dt_time_step_duration_years
            self.euler_vx[n+1] = self.euler_vx[n] + ax * dt_time_step_duration_years
            self.euler_vy[n+1] = self.euler_vy[n] + ay * dt_time_step_duration_years
            
            pbar.update(1)
        pbar.close()
        return self.euler_x, self.euler_y
    
    def rk2_method(self):
        '''Function for RK2 integration method calculations'''
        # Set initial conditions
        self.rk2_x[0] = self.x0
        self.rk2_y[0] = self.y0
        self.rk2_vx[0] = self.vx0
        self.rk2_vy[0] = self.vy0
        
        total_number_of_calculations_steps = self.get_total_number_of_calculations_steps()
        pbar = tqdm(total=total_number_of_calculations_steps-1, desc=f'RK2 method calculations...{self.name}')
        
        for n in range(total_number_of_calculations_steps - 1):
            # k1
            dx = self.rk2_x[n] - self.xs
            dy = self.rk2_y[n] - self.ys
            r = np.hypot(dx, dy)
            ax = -G * dx / r**3
            ay = -G * dy / r**3
            
            k1_x  = self.rk2_vx[n]
            k1_y  = self.rk2_vy[n]
            k1_vx = ax
            k1_vy = ay
            
            # k2 (euler step)
            x_e  = self.rk2_x[n]  + dt_time_step_duration_years * k1_x
            y_e  = self.rk2_y[n]  + dt_time_step_duration_years * k1_y
            vx_e = self.rk2_vx[n] + dt_time_step_duration_years * k1_vx
            vy_e = self.rk2_vy[n] + dt_time_step_duration_years * k1_vy
            
            dx_e = x_e - self.xs
            dy_e = y_e - self.ys
            r_e  = np.hypot(dx_e, dy_e)
            ax_e = -G * dx_e / r_e**3
            ay_e = -G * dy_e / r_e**3
            
            k2_x  = vx_e
            k2_y  = vy_e
            k2_vx = ax_e
            k2_vy = ay_e
            
            # Update using average of k1 and k2
            self.rk2_x[n+1]  = self.rk2_x[n]  + 0.5 * dt_time_step_duration_years * (k1_x  + k2_x)
            self.rk2_y[n+1]  = self.rk2_y[n]  + 0.5 * dt_time_step_duration_years * (k1_y  + k2_y)
            self.rk2_vx[n+1] = self.rk2_vx[n] + 0.5 * dt_time_step_duration_years * (k1_vx + k2_vx)
            self.rk2_vy[n+1] = self.rk2_vy[n] + 0.5 * dt_time_step_duration_years * (k1_vy + k2_vy)
            
            pbar.update(1)
        pbar.close()
        return self.rk2_x, self.rk2_y
    
    def rk4_method(self):
        '''Function for Runge-Kutta-4 (4th order integration) method calculations'''
        # Set initial conditions
        self.rk4_x[0] = self.x0
        self.rk4_y[0] = self.y0
        self.rk4_vx[0] = self.vx0
        self.rk4_vy[0] = self.vy0
        
        total_number_of_calculations_steps = self.get_total_number_of_calculations_steps()
        pbar = tqdm(total=total_number_of_calculations_steps-1, desc=f'RK4 method calculations...{self.name}')
        
        for n in range(total_number_of_calculations_steps - 1):
            # k1
            dx1 = self.rk4_x[n] - self.xs
            dy1 = self.rk4_y[n] - self.ys
            r1  = np.hypot(dx1, dy1)
            ax1 = -G * dx1 / r1**3
            ay1 = -G * dy1 / r1**3
            
            k1_x  = self.rk4_vx[n]
            k1_y  = self.rk4_vy[n]
            k1_vx = ax1
            k1_vy = ay1
            
            # k2
            x2  = self.rk4_x[n]  + 0.5 * dt_time_step_duration_years * k1_x
            y2  = self.rk4_y[n]  + 0.5 * dt_time_step_duration_years * k1_y
            vx2 = self.rk4_vx[n] + 0.5 * dt_time_step_duration_years * k1_vx
            vy2 = self.rk4_vy[n] + 0.5 * dt_time_step_duration_years * k1_vy
            
            dx2 = x2 - self.xs
            dy2 = y2 - self.ys
            r2  = np.hypot(dx2, dy2)
            ax2 = -G * dx2 / r2**3
            ay2 = -G * dy2 / r2**3
            
            k2_x  = vx2
            k2_y  = vy2
            k2_vx = ax2
            k2_vy = ay2
            
            # k3
            x3  = self.rk4_x[n]  + 0.5 * dt_time_step_duration_years * k2_x
            y3  = self.rk4_y[n]  + 0.5 * dt_time_step_duration_years * k2_y
            vx3 = self.rk4_vx[n] + 0.5 * dt_time_step_duration_years * k2_vx
            vy3 = self.rk4_vy[n] + 0.5 * dt_time_step_duration_years * k2_vy
            
            dx3 = x3 - self.xs
            dy3 = y3 - self.ys
            r3  = np.hypot(dx3, dy3)
            ax3 = -G * dx3 / r3**3
            ay3 = -G * dy3 / r3**3
            
            k3_x  = vx3
            k3_y  = vy3
            k3_vx = ax3
            k3_vy = ay3
            
            # k4
            x4  = self.rk4_x[n]  + dt_time_step_duration_years * k3_x
            y4  = self.rk4_y[n]  + dt_time_step_duration_years * k3_y
            vx4 = self.rk4_vx[n] + dt_time_step_duration_years * k3_vx
            vy4 = self.rk4_vy[n] + dt_time_step_duration_years * k3_vy
            
            dx4 = x4 - self.xs
            dy4 = y4 - self.ys
            r4  = np.hypot(dx4, dy4)
            ax4 = -G * dx4 / r4**3
            ay4 = -G * dy4 / r4**3
            
            k4_x  = vx4
            k4_y  = vy4
            k4_vx = ax4
            k4_vy = ay4
            
            # Update using weighted average // All K
            self.rk4_x[n+1]  = self.rk4_x[n]  + (dt_time_step_duration_years / 6.0) * (k1_x  + 2*k2_x  + 2*k3_x  + k4_x)
            self.rk4_y[n+1]  = self.rk4_y[n]  + (dt_time_step_duration_years / 6.0) * (k1_y  + 2*k2_y  + 2*k3_y  + k4_y)
            self.rk4_vx[n+1] = self.rk4_vx[n] + (dt_time_step_duration_years / 6.0) * (k1_vx + 2*k2_vx + 2*k3_vx + k4_vx)
            self.rk4_vy[n+1] = self.rk4_vy[n] + (dt_time_step_duration_years / 6.0) * (k1_vy + 2*k2_vy + 2*k3_vy + k4_vy)
            
            pbar.update(1)
        pbar.close()
        return self.rk4_x, self.rk4_y
    
    def leapfrog_method(self):
        '''Function for Leapfrog integration method calculations'''
        # Set initial conditions
        self.leapfrog_x[0] = self.x0
        self.leapfrog_y[0] = self.y0
        self.leapfrog_vx[0] = self.vx0
        self.leapfrog_vy[0] = self.vy0
        
        total_number_of_calculations_steps = self.get_total_number_of_calculations_steps()
        pbar = tqdm(total=total_number_of_calculations_steps-1, desc=f'Leapfrog method calculations...{self.name}')
        
        for n in range(total_number_of_calculations_steps - 1):
            dx = self.leapfrog_x[n] - self.xs
            dy = self.leapfrog_y[n] - self.ys
            r = np.hypot(dx, dy)
            ax = -G * dx / r**3
            ay = -G * dy / r**3
            
            # Half-step velocity update
            vx_half = self.leapfrog_vx[n] + 0.5 * dt_time_step_duration_years * ax
            vy_half = self.leapfrog_vy[n] + 0.5 * dt_time_step_duration_years * ay
            
            # Full-step position update
            x_new = self.leapfrog_x[n] + dt_time_step_duration_years * vx_half
            y_new = self.leapfrog_y[n] + dt_time_step_duration_years * vy_half
            
            # New acceleration
            dx_new = x_new - self.xs
            dy_new = y_new - self.ys
            r_new = np.hypot(dx_new, dy_new)
            ax_new = -G * dx_new / r_new**3
            ay_new = -G * dy_new / r_new**3
            
            # Half-step velocity update
            vx_new = vx_half + 0.5 * dt_time_step_duration_years * ax_new
            vy_new = vy_half + 0.5 * dt_time_step_duration_years * ay_new
            
            self.leapfrog_x[n+1] = x_new
            self.leapfrog_y[n+1] = y_new
            self.leapfrog_vx[n+1] = vx_new
            self.leapfrog_vy[n+1] = vy_new
            
            pbar.update(1)
        pbar.close()
        return self.leapfrog_x, self.leapfrog_y

